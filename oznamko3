function calcBuildingPop(name, level) {
    if (level <= 0) return 0;
    var d = buildingPopData[name];
    if (!d) return 0;
    return Math.round(d[0] * Math.pow(d[1], level - 1));
}

function getTroopRole(index, hasArchers) {
    if (hasArchers) {
        if (2 == index || 5 == index || 6 == index || 8 == index) return "off";
        if (0 == index || 1 == index || 3 == index || 7 == index) return "def";
        return "ignore";
    }

    if (2 == index || 4 == index || 6 == index) return "off";
    if (0 == index || 1 == index || 5 == index) return "def";
    return "ignore";
}

function addTroopPop(target, index, amount, farmPop, hasArchers) {
    var role = getTroopRole(index, hasArchers);
    if ("off" == role) {
        target.ofensivas += amount * farmPop[index];
    } else if ("def" == role) {
        target.defensivas += amount * farmPop[index];
    }
}

function createTroopSummary() {
    return { ofensivas: 0, defensivas: 0 };
}

function getCatapultIndex(hasArchers) {
    return hasArchers ? 9 : 7;
}

function getTroopRowValues(selector, expectedLength) {
    var values = new Array(expectedLength).fill(0);

    $(selector).each((function (index, cell) {
        if (index < expectedLength) values[index] = parseInt(cell.textContent, 10) || 0;
    }));

    return values;
}

function calculateSurvivors(sent, losses) {
    return sent.map((function (amount, index) {
        return Math.max(0, amount - (losses[index] || 0));
    }));
}

function summarizeTroops(values, farmPop, hasArchers) {
    var summary = createTroopSummary();

    values.forEach((function (amount, index) {
        addTroopPop(summary, index, amount, farmPop, hasArchers);
    }));

    return summary;
}

function formatImpactDate(rawText) {
    rawText = rawText || "";
    var match = rawText.match(/(\d{1,2})\s*[.\/-]\s*(\d{1,2})\s*[.\/-]\s*(\d{2,4})/i);
    if (!match) return "";

    var year = match[3].length == 2 ? "20" + match[3] : match[3];
    var timeMatch = rawText.match(/(?:^|\D)(\d{1,2}:\d{2}(?::\d{2})?)(?:\D|$)/);
    return parseInt(match[1], 10) + "." + parseInt(match[2], 10) + "." + year + (timeMatch ? " " + timeMatch[1] : "");
}

function getReportImpactDate() {
    var impactDate = "";
    var preferredLabels = ["cas dopadu", "datum dopadu", "dopad", "prichod", "datum"];

    $("#content_value tr").each((function () {
        if (impactDate) return;

        var row = $(this);
        var normalized = normalizeReportLabel(row.text());
        if (normalized.indexOf("navratu") > -1) return;

        var isPreferred = preferredLabels.some((function (label) {
            return normalized.indexOf(label) > -1;
        }));

        if (isPreferred) impactDate = formatImpactDate(row.text());
    }));

    if (impactDate) return impactDate;

    // Na roznych svetoch nema oznam o dopade rovnaky popis. Ako zaloha
    // vezmeme prvy datum v hlavicke reportu, nikdy vsak datum z riadku Navrat.
    $("#content_value tr").each((function () {
        if (impactDate) return;
        var rowText = $(this).text();
        if (normalizeReportLabel(rowText).indexOf("navratu") == -1) {
            impactDate = formatImpactDate(rowText);
        }
    }));

    return impactDate;
}

function getOffRipText(dados) {
    var sentOff = dados.aldeia.ofensiva.tropas.vyslane.ofensivas;
    var lostOff = dados.aldeia.ofensiva.tropas.straty.ofensivas;

    // Male farmy a spionaze sa nemaju oznacovat ako znicena OFF armada.
    if (sentOff < 1000 || lostOff <= 0) return "";

    var remainingOff = Math.max(0, sentOff - lostOff);
    var lossRatio = Math.min(1, lostOff / sentOff);
    var dateText = getReportImpactDate();
    var prefix = dateText ? dateText + " " : "";

    if (remainingOff <= Math.max(10, Math.round(sentOff * .01))) {
        return prefix + "OFF RIP";
    }

    var quarters = Math.round(lossRatio * 4);
    if (quarters < 1) return "";
    if (quarters > 3) quarters = 3;
    return prefix + quarters + "/4 OFF RIP";
}

function getOutsideVillageType(offPop, defPop) {
    if (offPop > 3e3 && offPop > defPop) return _t("offensive");
    if (defPop > 1e3 && defPop >= offPop) return _t("defensive");
    if (offPop > 1e3 && offPop > defPop) return _t("probOffensive");
    if (defPop > 500 && defPop >= offPop) return _t("probDefensive");
    if (offPop + defPop > 1e3) return offPop > defPop ? _t("probOffensive") : _t("probDefensive");
    return "";
}

