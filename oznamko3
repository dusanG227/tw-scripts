function normalizeReportLabel(text) {
    text = (text || "").toLowerCase();
    text = text.normalize ? text.normalize("NFD").replace(/[\u0300-\u036f]/g, "") : text;

    return text
        .replace(/[áä]/g, "a")
        .replace(/č/g, "c")
        .replace(/ď/g, "d")
        .replace(/[éě]/g, "e")
        .replace(/í/g, "i")
        .replace(/[ĺľ]/g, "l")
        .replace(/ň/g, "n")
        .replace(/[óô]/g, "o")
        .replace(/ŕ/g, "r")
        .replace(/š/g, "s")
        .replace(/ť/g, "t")
        .replace(/ú/g, "u")
        .replace(/ý/g, "y")
        .replace(/ž/g, "z")
        .replace(/\s+/g, " ")
        .trim();
}

function getReportReturnTime() {
    var returnTime = "";

    $("#content_value tr").each((function () {
        if (returnTime) return;

        var cells = $(this).children("td, th");
        if (cells.length < 2) return;

        var label = normalizeReportLabel($(cells[0]).text());
        if (label.indexOf("cas navratu") > -1) {
            var value = $(cells[1]).text().replace(/\s+/g, " ").trim();
            value && (returnTime = "Návrat: " + value);
        }
    }));

    if (returnTime) return returnTime;

    return $("#content_value > table > tbody > tr > td:nth-child(2) > table > tbody > tr > td > table:nth-child(2) > tbody > tr:nth-child(4)")
        .text()
        .replace(/\s+/g, " ")
